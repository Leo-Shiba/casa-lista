# Chave secreta para assinar os logins (JWT). Use algo longo e aleatório em produção.
JWT_SECRET=troque-por-uma-chave-secreta-longa

# Porta (a Square Cloud injeta sozinha; localmente usa 3000)
PORT=3000

# URL pública do app (usada nos links de email). Ex: https://leocasalista.squareweb.app
APP_URL=

# ---- Email (opcional): recuperar senha e confirmar email ----
# Ex. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 e uma "senha de app" em SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Busca de preço no Mercado Livre (opcional) ----
# Crie um app em https://developers.mercadolivre.com.br e preencha:
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
